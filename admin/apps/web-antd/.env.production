VITE_BASE=/

VITE_APP_TITLE=短视频获客
VITE_APP_NAMESPACE=short-video-leads-admin

# 接口地址 - 只配置域名，/api/admin 前缀在代码里
VITE_GLOB_API_URL=https://dspapi.wangwei.tech

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
