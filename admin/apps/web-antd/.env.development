# 端口号
VITE_PORT=5666

VITE_BASE=/

VITE_APP_TITLE=短视频获客
VITE_APP_NAMESPACE=short-video-leads-admin

# 接口地址 - 只配置域名，/api/admin 前缀在代码里
VITE_GLOB_API_URL=

# 是否开启 Nitro Mock服务，false 关闭（使用真实后端）
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
