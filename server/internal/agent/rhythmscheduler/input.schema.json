{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zaotai.local/schemas/a6.input.json",
  "title": "A6 节奏调度师 · 输入契约",
  "description": "门店阶段、周期长度、已确认脚本与产能/时段/节假日约束。缺必填字段时 Runner 直接拒绝执行，不靠模型兜底。",
  "type": "object",
  "additionalProperties": false,
  "required": ["clientId", "weeks", "scriptIds", "constraints", "stage"],
  "properties": {
    "clientId": {
      "type": "string",
      "minLength": 1,
      "description": "门店档案目录名，用于装配 L2 档案层，如 xiangcaiguan"
    },
    "weeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "排期覆盖的周数，1–8 周"
    },
    "stage": {
      "type": "string",
      "minLength": 1,
      "description": "门店阶段，需与门店档案一致，如 新店期 / 成长期"
    },
    "scriptIds": {
      "type": "array",
      "description": "已确认脚本的 artifactId 列表，可空；空时用通用档期占位",
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["每周可拍条数", "可发布时段", "节假日"],
      "properties": {
        "每周可拍条数": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "门店每周实际可产出的内容条数上限，1–10"
        },
        "可发布时段": {
          "type": "array",
          "minItems": 1,
          "description": "允许发布的时段，如 午间 11:30–13:00",
          "items": { "type": "string", "minLength": 1 }
        },
        "节假日": {
          "type": "array",
          "description": "周期内的节假日/店休日，可空；命中的日期必须给出特殊说明",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
