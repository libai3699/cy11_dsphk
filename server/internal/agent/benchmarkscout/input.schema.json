{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zaotai.local/schemas/a1.input.json",
  "title": "A1 对标猎手 · 输入契约",
  "description": "人工筛选过的候选账号列表与粘贴的对标内容素材。缺必填字段时 Runner 直接拒绝执行，不靠模型兜底。",
  "type": "object",
  "additionalProperties": false,
  "required": ["clientId", "platform", "cityKeyword", "seedAccounts", "pastedSamples"],
  "properties": {
    "clientId": {
      "type": "string",
      "minLength": 1,
      "description": "门店档案目录名，用于装配 L2 档案层，如 xiangcaiguan"
    },
    "platform": {
      "type": "string",
      "description": "对标平台，如 douyin / xiaohongshu"
    },
    "cityKeyword": {
      "type": "string",
      "description": "城市关键词，用于判断同城对标价值，如 长沙"
    },
    "seedAccounts": {
      "type": "array",
      "minItems": 1,
      "description": "人工给出的候选账号，逐账号评估对标价值后筛出推荐列表",
      "items": { "type": "string", "minLength": 1 }
    },
    "pastedSamples": {
      "type": "array",
      "minItems": 1,
      "description": "粘贴的内容素材（评论区、文案、视频描述等），每条标注作者",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["author", "text"],
        "properties": {
          "author": { "type": "string", "minLength": 1, "description": "素材所属账号名" },
          "text": { "type": "string", "minLength": 1, "description": "粘贴的原始内容文本" },
          "metrics": { "type": "object", "description": "可选。该条素材对应的播放/点赞等数据原值，仅引用不推算" }
        }
      }
    },
    "excludeAccounts": {
      "type": "array",
      "description": "可选。明确排除的账号，一律不进推荐列表",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
